#!/usr/bin/env bash
# Prismaera repo pre-commit hook
# - scripts/check_repo_rules.py (構造ルール全般 + version/changelog/競合マーカー 等)
# - scripts/check_prompt_rules.py --staged (staged の画像プロンプト md: ANATOMY ブロック + 末尾文言)
# 違反があれば commit abort
#
# Setup (一度だけ各PCで): git config core.hooksPath .githooks
#
# 2026-11-25: 旧ガード `[ ! -d prompt ] && exit 0` を修正。 2026-05-06 (v1.5.1l) に prompt/ を content/prompt/ へ
# 移動して以降、 このガードで hook が毎回 exit 0 になり 全チェックが素通りしていた。

if [ ! -f scripts/check_repo_rules.py ]; then
  exit 0
fi

if command -v py >/dev/null 2>&1; then
  PY_CMD="py"
elif command -v python >/dev/null 2>&1; then
  PY_CMD="python"
else
  echo "[pre-commit] ⚠️ Python not found, skipping repo rule check"
  exit 0
fi

RC=0
PYTHONIOENCODING=utf-8 $PY_CMD scripts/check_repo_rules.py || RC=$?
if [ $RC -ne 0 ]; then
  echo ""
  echo "[pre-commit] ❌ Prismaera repo ルール違反 → commit abort"
  echo "  scripts/check_repo_rules.py の指摘を修正してから再度 commit してください"
  exit 1
fi

RC=0
PYTHONIOENCODING=utf-8 $PY_CMD scripts/check_prompt_rules.py --staged || RC=$?
if [ $RC -ne 0 ]; then
  echo ""
  echo "[pre-commit] ❌ 画像プロンプト ルール違反 (staged の prompt md) → commit abort"
  echo "  scripts/check_prompt_rules.py の指摘を修正してから再度 commit してください"
  exit 1
fi

exit 0
